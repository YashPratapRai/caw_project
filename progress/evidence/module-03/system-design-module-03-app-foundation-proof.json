  "architectural_surfaces": {
    "security_surface": {
      "title": "Open Redirect Prevention",
      "vulnerability": "Phishing via untrusted redirect URLs",
      "validation_rules": [
        "Protocol whitelist: http://, https:// only",
        "URL must be valid and parseable",
        "Length limit: max 2048 characters",
        "No javascript:, data:, or file: protocols"
      ],
      "design_choice": "Trust URL as-is from authenticated client",
      "proof_artifact": "progress/evidence/module-03/SECURITY_SURFACE_PROOF.md"
    },

    "routing_surface": {
      "title": "Route Collision Prevention",
      "challenge": "Prevent collisions between static (/links, /health) and dynamic (/r/:code) routes",
      "solution": "/r/{code} prefix isolation for public redirects",
      "architecture": [
        "Static routes processed before dynamic routes",
        "/links and /health remain on fixed paths",
        "/r/:code cannot interfere with static routes"
      ],
      "design_choice": "Chosen: /r/ prefix with clear semantic meaning",
      "alternatives_rejected": [
        "Subdomain routing (operational complexity)",
        "Parameter-only routing (collision risk)"
      ],
      "proof_artifact": "progress/evidence/module-03/ROUTING_SURFACE_PROOF.md"
    },

    "debugging_surface": {
      "title": "Userinfo Bypass Vulnerability Fix",
      "hypothesis": "Extra JSON fields might bypass authorization",
      "vulnerability_type": "Field injection attack",
      "failure_boundary": "Input validation layer",
      "root_cause": "Type guards without strict schema enforcement",
      "reproduction": "POST /links with userinfo field accepted (201)",
      "fix": "ValidationPipe with forbidNonWhitelisted: true",
      "verification_before": "HTTP 201 - vulnerable to injection",
      "verification_after": "HTTP 422 - field injection blocked",
      "proof_artifact": "progress/evidence/module-03/DEBUGGING_SURFACE_PROOF.md"
    }
  },

  "production_features": {
    "authentication": "API key validation with principal ID mapping",
    "input_validation": "Strict DTO validation with forbidNonWhitelisted enforcement",
    "rate_limiting": "10 req/min on POST /links, 120 req/min on GET /r/:code",
    "logging": "Structured JSON logging with sensitive field redaction",
    "error_handling": "Appropriate HTTP status codes and error messages",
    "database": "Schema with indexes for performance and uniqueness"
  },

